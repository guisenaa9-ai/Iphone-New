# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Cada loja tem seu próprio projeto Supabase e seus próprios valores.

# Supabase — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ir para o navegador: o acesso é limitado pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço (service_role / secret). SOMENTE servidor. Obrigatória: pedidos, trocas e webhook de pagamento.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público da loja (domínio próprio), sem barra no final.
NEXT_PUBLIC_SITE_URL=https://www.minhaloja.com.br

# Mercado Pago (opcional — sem estes dois, a loja vende só pelo WhatsApp)
# Suas integrações › Credenciais de produção › Access Token
MERCADOPAGO_ACCESS_TOKEN=
# Suas integrações › Webhooks › Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=

# Testes E2E (opcional; use um admin de TESTE, nunca o da loja real)
# E2E_BASE_URL=http://localhost:3000
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
